# Never let a real environment file, credential, or Git history reach a
# build context / image layer. See docs/ecs/container-architecture.md.

.git
.gitattributes
.github

# Environment files — never copied into the image. Runtime config comes
# exclusively from ECS task-definition environment/secrets.
.env
.env.*
!.env.example
!.env.testing.example

# Local secrets used only by tools/rls-test/ tooling, never shipped.
.rls-test-secrets/

# Dependency directories — reinstalled inside the image by the vendor/
# frontend build stages, never copied in from the host.
/vendor
/node_modules

# Build output the frontend stage regenerates; a stale host copy must not
# leak into the image and silently shadow a real build.
/public/build
/public/hot
/public/storage

# Local runtime/cache state — must not carry host-machine artifacts into the
# image; the Dockerfile creates these directories fresh and empty.
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*
/storage/logs/*
/bootstrap/cache/*.php
!/storage/framework/cache/data/.gitignore
!/storage/framework/sessions/.gitignore
!/storage/framework/testing/.gitignore
!/storage/framework/views/.gitignore
!/storage/logs/.gitignore
!/bootstrap/cache/.gitignore

# Test/dev-only content — not needed at runtime; keeps the image smaller and
# ensures test fixtures/credentials never ship in a production layer.
/tests
/tools
/docs
/.claude
phpunit.xml
.phpunit.result.cache
.phpunit.cache

# Editor/IDE and OS cruft.
.DS_Store
Thumbs.db
.idea
.vscode
.nova
.zed
.cursor
_ide_helper.php
Homestead.json
Homestead.yaml

# Local dev tooling not relevant inside the image. NOTE: .npmrc is NOT
# ignored — the frontend build stage COPYs it in (it only sets
# ignore-scripts/audit flags, no secrets) and needs it present in the build
# context.
.editorconfig
README.md
