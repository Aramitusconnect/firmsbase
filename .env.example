APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Required for PlatformNotificationCorrelationService (password-reset
# emails that cannot resolve an owning firm). A dedicated, platform-wide
# secret used to derive a keyed HMAC-SHA256 fingerprint of the recipient
# address — never plaintext, never derived from APP_KEY. Generate once
# via `php artisan tinker --execute="echo bin2hex(random_bytes(32));"`
# (or any equivalent CSPRNG) and keep it stable — rotating it makes
# every existing platform_notification_suppressions row unmatchable
# against future events. Missing/empty fails closed: no email is sent
# on the platform-scope fallback path (see CorrelatedPasswordResetSenderService).
PLATFORM_NOTIFICATIONS_RECIPIENT_FINGERPRINT_HMAC_KEY=

VITE_APP_NAME="${APP_NAME}"

# Internal, non-production TestProvider (App\Integrations\Providers\TestProvider\TestProvider)
# — default OFF. Never enable in a production environment.
INTEGRATIONS_TEST_PROVIDER_ENABLED=false
INTEGRATIONS_RETENTION_SWEEP_FIRM_DATA_ENABLED=false

# Integration provider registry — each provider is gated OFF by default
# (config/integrations.php `providers`). Enabling a provider here alone
# does not make it usable: each one's own oauth_apps client_id/secret
# below must also be set, or that provider's isConfigured() check still
# reports it as unconfigured.
INTEGRATIONS_MICROSOFT365_ENABLED=false
INTEGRATIONS_GOOGLEWORKSPACE_ENABLED=false
INTEGRATIONS_PLAID_ENABLED=false

# Integration outbox dispatch/retry/retention (config/integrations.php `outbox`)
INTEGRATIONS_OUTBOX_MAX_BACKOFF_SECONDS=3600
INTEGRATIONS_OUTBOX_COMPLETED_RETENTION_DAYS=30
INTEGRATIONS_OUTBOX_DEAD_LETTERED_RETENTION_DAYS=90
INTEGRATIONS_OUTBOX_CANCELLED_RETENTION_DAYS=30

# Integration OAuth state retention (config/integrations.php `oauth_states`)
INTEGRATIONS_OAUTH_STATES_CONSUMED_RETENTION_HOURS=72
# No safe default exists for this one (see config/integrations.php's own
# docblock) — the retention sweep intentionally no-ops until a human
# explicitly sets it. Leave commented out unless you have deliberately
# decided on a value.
# INTEGRATIONS_OAUTH_STATES_UNCONSUMED_EXPIRED_RETENTION_HOURS=

# Integration sync run/item and conflict retention
INTEGRATIONS_SYNC_RUNS_RETENTION_DAYS=180
INTEGRATIONS_SYNC_ITEMS_RETENTION_DAYS=60
INTEGRATIONS_CONFLICTS_RETENTION_DAYS=365

# Integration webhook receipt retention
INTEGRATIONS_WEBHOOK_RECEIPT_VERIFIED_RETENTION_DAYS=30

# Integration connection health (config/integrations.php `health`)
INTEGRATIONS_HEALTH_BACKOFF_BASE_SECONDS=60
INTEGRATIONS_HEALTH_BACKOFF_MAX_SECONDS=3600
INTEGRATIONS_HEALTH_DEGRADED_AFTER_FAILURES=1
INTEGRATIONS_HEALTH_UNAVAILABLE_AFTER_FAILURES=3
INTEGRATIONS_HEALTH_DIAGNOSTIC_SUMMARY_MAX_LENGTH=500

# Integration platform-owned retention sweep batching
INTEGRATIONS_RETENTION_PLATFORM_MAX_BATCHES_PER_RUN=50

# No safe default exists for this one either (config/integrations.php's
# own docblock deliberately rejects guessing a number) — leave
# commented out unless you have deliberately decided on a value.
# INTEGRATIONS_USAGE_RECORDS_RETENTION_DAYS=

# Integration outbound HTTP path (config/integrations.php `http`)
INTEGRATIONS_HTTP_DEFAULT_TIMEOUT_SECONDS=15
INTEGRATIONS_HTTP_CONNECT_TIMEOUT_SECONDS=5
INTEGRATIONS_HTTP_CORRELATION_ID_HEADER="X-FirmsVault-Correlation-Id"

# Integration outbound rate limits (config/integrations.php `rate_limits`)
INTEGRATIONS_RATE_LIMIT_DEFAULT_MAX_ATTEMPTS=30
INTEGRATIONS_RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60
INTEGRATIONS_RATE_LIMIT_TEST_MAX_ATTEMPTS=100
INTEGRATIONS_RATE_LIMIT_TEST_WINDOW_SECONDS=60
INTEGRATIONS_RATE_LIMIT_MICROSOFT365_MAX_ATTEMPTS=30
INTEGRATIONS_RATE_LIMIT_MICROSOFT365_WINDOW_SECONDS=60
INTEGRATIONS_RATE_LIMIT_GOOGLEWORKSPACE_MAX_ATTEMPTS=30
INTEGRATIONS_RATE_LIMIT_GOOGLEWORKSPACE_WINDOW_SECONDS=60
INTEGRATIONS_RATE_LIMIT_PLAID_MAX_ATTEMPTS=30
INTEGRATIONS_RATE_LIMIT_PLAID_WINDOW_SECONDS=60

# Microsoft 365 provider environment + platform OAuth app credentials
# (config/integrations.php `provider_environments`/`oauth_apps`). The
# base URL overrides below rarely need changing — leave them unset to
# use Microsoft's own documented hosts.
INTEGRATIONS_MICROSOFT365_MODE=sandbox
# INTEGRATIONS_MICROSOFT365_SANDBOX_IDENTITY_BASE_URL=
# INTEGRATIONS_MICROSOFT365_SANDBOX_GRAPH_BASE_URL=
# INTEGRATIONS_MICROSOFT365_LIVE_IDENTITY_BASE_URL=
# INTEGRATIONS_MICROSOFT365_LIVE_GRAPH_BASE_URL=
INTEGRATIONS_MICROSOFT365_CLIENT_ID=
INTEGRATIONS_MICROSOFT365_CLIENT_SECRET=

# Google Workspace provider environment + platform OAuth app credentials.
# The base URL overrides below rarely need changing — leave them unset
# to use Google's own documented hosts.
INTEGRATIONS_GOOGLEWORKSPACE_MODE=sandbox
# INTEGRATIONS_GOOGLEWORKSPACE_SANDBOX_TOKEN_BASE_URL=
# INTEGRATIONS_GOOGLEWORKSPACE_SANDBOX_GMAIL_BASE_URL=
# INTEGRATIONS_GOOGLEWORKSPACE_SANDBOX_CALENDAR_BASE_URL=
# INTEGRATIONS_GOOGLEWORKSPACE_SANDBOX_DRIVE_BASE_URL=
# INTEGRATIONS_GOOGLEWORKSPACE_LIVE_TOKEN_BASE_URL=
# INTEGRATIONS_GOOGLEWORKSPACE_LIVE_GMAIL_BASE_URL=
# INTEGRATIONS_GOOGLEWORKSPACE_LIVE_CALENDAR_BASE_URL=
# INTEGRATIONS_GOOGLEWORKSPACE_LIVE_DRIVE_BASE_URL=
INTEGRATIONS_GOOGLEWORKSPACE_CLIENT_ID=
INTEGRATIONS_GOOGLEWORKSPACE_CLIENT_SECRET=
# Gmail Cloud Pub/Sub push-delivery trust boundary — see
# config/integrations.php's own docblock for exactly what each of these
# verifies before an inbound Gmail webhook is trusted.
INTEGRATIONS_GOOGLEWORKSPACE_PUBSUB_PUSH_AUDIENCE=
INTEGRATIONS_GOOGLEWORKSPACE_PUBSUB_PUSH_SERVICE_ACCOUNT_EMAIL=
INTEGRATIONS_GOOGLEWORKSPACE_GMAIL_MAILBOX_ROUTING_HMAC_KEY=
INTEGRATIONS_GOOGLEWORKSPACE_GMAIL_PUBSUB_TOPIC_NAME=

# Plaid provider environment + platform credentials (config/integrations.php
# `provider_environments`/`oauth_apps`). The base URL overrides below
# rarely need changing — leave them unset to use Plaid's own documented
# sandbox/production hosts.
INTEGRATIONS_PLAID_MODE=sandbox
# INTEGRATIONS_PLAID_SANDBOX_BASE_URL=
# INTEGRATIONS_PLAID_LIVE_BASE_URL=
INTEGRATIONS_PLAID_CLIENT_ID=
INTEGRATIONS_PLAID_SECRET=
INTEGRATIONS_PLAID_ITEM_ROUTING_HMAC_KEY=
INTEGRATIONS_PLAID_WEBHOOK_URL=

# Integration billing/cost-control pipeline (config/integrations.php `provider_billing`)
INTEGRATIONS_PROVIDER_BILLING_RESERVATION_TTL_SECONDS=120
INTEGRATIONS_PROVIDER_BILLING_DEFAULT_COOLDOWN_SECONDS=0
INTEGRATIONS_PROVIDER_BILLING_ANOMALY_MULTIPLIER=3
INTEGRATIONS_PROVIDER_BILLING_ANOMALY_COLD_START_CEILING=200
