# Section 39A-3L Stage A — secret-free template.
#
# Do NOT fill in a real password here and commit it. This file exists only
# to document the expected shape. Actual testing env vars are generated
# per-run by tools/rls-test/run-artisan-test.sh from
# .rls-test-secrets/rls_test_runner_39a3l.pgpass (gitignored) and a
# uniquely named disposable database created for that run.
#
# DB_DATABASE below is a placeholder illustrating the required naming
# pattern; the wrapper substitutes a real per-run value matching
# firmsbase_test_39a3l_disposable_<purpose>_<run_id>.

APP_ENV=testing
APP_DEBUG=false
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=firmsbase_test_39a3l_disposable_purpose_runid
DB_USERNAME=rls_test_runner_39a3l
DB_PASSWORD=
