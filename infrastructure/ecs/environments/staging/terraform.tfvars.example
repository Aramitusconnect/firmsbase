# Copy to terraform.tfvars and fill in real values (or, better, pass
# sensitive values via -var/-var-file sourced from Secrets Manager at plan
# time rather than committing them to a tfvars file at all).
# terraform.tfvars is gitignored (see infrastructure/ecs/.gitignore) —
# never commit real values.
#
# Every value below is a placeholder. See docs/ecs/staging-readiness-report.md
# "required AWS inputs" for who needs to supply each one and why this
# mission does not fill them in itself.

aws_region  = "us-east-1"
name_prefix = "firmsbase-staging"

vpc_id              = "vpc-REPLACE_ME"
public_subnet_ids   = ["subnet-REPLACE_ME_PUBLIC_A", "subnet-REPLACE_ME_PUBLIC_B"]
private_subnet_ids  = ["subnet-REPLACE_ME_PRIVATE_A", "subnet-REPLACE_ME_PRIVATE_B"]
alb_ingress_cidr_blocks = ["203.0.113.0/24"] # replace with actual allowed staging-access range

acm_certificate_arn = "arn:aws:acm:us-east-1:ACCOUNT_ID:certificate/REPLACE_ME"

# Confirmed live staging value (present as a plain APP_URL environment
# variable on the running web task, previously unmodeled by this config —
# see docs/ecs/staging-variable-inventory.md). Used for generated links,
# password-reset/invitation URLs, redirects, and callback URLs — must stay
# present through any ECS task-definition migration.
app_url = "https://staging.firmsvault.com"

rds_instance_id       = "REPLACE_ME"
rds_security_group_id = "sg-REPLACE_ME"
db_host                = "REPLACE_ME.rds.amazonaws.com"
db_database              = "firmsbase_staging"

# Supplied by the CI/CD pipeline for a real deploy — see
# .github/workflows/ecs-pipeline.yml. Never hand-typed for anything beyond
# a local `terraform validate`/`plan` dry run.
app_image_digest = "ACCOUNT_ID.dkr.ecr.us-east-1.amazonaws.com/firmsbase-app@sha256:REPLACE_ME"

# Bare secret ARNs only — do NOT append a ":<json-key>::" selector here.
# Each of these three live secrets is a JSON blob with multiple keys;
# main.tf's local.shared_secrets derives the exact ECS valueFrom selector
# (":APP_KEY::", ":password::", ":REDIS_PASSWORD::" respectively)
# automatically from the bare ARN below. See
# docs/ecs/staging-variable-inventory.md.
app_key_secret_arn          = "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:firmsbase/staging/app-key-REPLACE_ME"
db_password_secret_arn       = "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:firmsbase/staging/db-password-REPLACE_ME"
redis_auth_token_secret_arn   = "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:firmsbase/staging/redis-auth-token-REPLACE_ME"
# The migrate task's dedicated, more-privileged DB credential — distinct
# from db_password_secret_arn's regular app-user credential. Live value
# confirmed via aws iam get-role-policy (the task-execution role's own
# inline policy grants secretsmanager:GetSecretValue on this exact ARN).
db_migrator_secret_arn      = "arn:aws:secretsmanager:us-east-1:603013471426:secret:firmsbase/staging/database-migrator-TpsE6P"
# redis_auth_token: do NOT put the real value here — pass via
# `-var="redis_auth_token=$(aws secretsmanager get-secret-value ...)"` at
# plan/apply time instead.

# Resolved 2026-08-03: topic created and an email subscription to
# firmsvault@gmail.com confirmed. This is the TOPIC ARN — never the
# subscription ARN (which carries a trailing UUID after the topic name;
# SNS topic ARNs never do). See docs/ecs/staging-variable-inventory.md.
alarm_sns_topic_arn = "arn:aws:sns:us-east-1:603013471426:firmsbase-staging-alarms"

enable_custom_metric_alarms = false

# --- SES bounce/complaint SQS consumer (ses-consumer role) — the queue
# URL/ARN and DLQ ARN below are resource IDENTIFIERS, not secrets, so this
# example shows the expected real staging naming/format directly (only the
# account ID is a placeholder, matching the rest of this file). The HMAC
# secret ARN below is likewise just an identifier — but the secret VALUE it
# points at must never appear here, in any tfvars file, in Terraform state,
# or in any Terraform output. See docs/ecs/iam-matrix.md and
# CorrelatedPasswordResetSenderService/PlatformNotificationCorrelationService.
ses_events_queue_url = "https://sqs.us-east-1.amazonaws.com/ACCOUNT_ID/firmsvault-staging-ses-events"
ses_events_queue_arn = "arn:aws:sqs:us-east-1:ACCOUNT_ID:firmsvault-staging-ses-events"
ses_events_dlq_arn   = "arn:aws:sqs:us-east-1:ACCOUNT_ID:firmsvault-staging-ses-events-dlq"

# --- SES outbound mail sending (web role only) — verified staging sender.
# Both values below are resource identifiers, not secrets: the identity ARN
# names a verified SES domain identity (no secret material), and the From
# address is the same one already configured as MAIL_FROM_ADDRESS in
# main.tf's shared_environment. Never grant this to ses_consumer or any
# other role — see infrastructure/ecs/modules/iam/main.tf and
# docs/ecs/iam-matrix.md.
ses_sending_identity_arn    = "arn:aws:ses:us-east-1:ACCOUNT_ID:identity/staging-mail.firmsvault.com"
ses_authorized_from_address = "no-reply@staging-mail.firmsvault.com"

# Resolved 2026-08-03: created OUTSIDE Terraform via a server-side-generated
# value (never handled locally or by Terraform). Bare ARN only — never the
# value itself. Confirmed independently via `aws secretsmanager
# describe-secret` (ARN/Name only, value never retrieved): uses the default
# AWS-managed Secrets Manager KMS key, not scheduled for deletion. See
# docs/ecs/staging-variable-inventory.md.
platform_notifications_recipient_fingerprint_hmac_key_secret_arn = "arn:aws:secretsmanager:us-east-1:603013471426:secret:firmsbase/staging/platform-notifications-hmac-key-PFBzd3"

# Consumer tuning — safe defaults already match config/services.php's own
# env() fallbacks; only listed here for visibility/override.
ses_events_wait_time_seconds           = 20
ses_events_visibility_timeout_seconds  = 60
ses_events_max_messages                = 10
ses_consumer_desired_count             = 1
ses_consumer_cpu                       = 256
ses_consumer_memory                    = 512
ses_consumer_stop_timeout              = 45

# --- Live-infrastructure-adoption overrides — see
# docs/ecs/state-adoption-plan.md. All null/false by default (safe for a
# brand-new environment); THIS staging environment's live resources need
# every one of the non-comment values below set exactly as shown before any
# import is attempted — see the plan doc for why each one exists.
ecs_cluster_name              = "firmsbase-staging-cluster"
# Live cluster currently has NO capacity providers associated at all
# (confirmed via aws ecs describe-clusters — capacityProviders: [],
# defaultCapacityProviderStrategy: []); every live service instead uses a
# fixed launch_type=FARGATE (see use_capacity_provider_strategy=false on
# every service below). This value only lets the aws_ecs_cluster_capacity_providers
# resource address represent that live (empty) state — it does not itself
# authorize associating capacity providers with the live cluster, which
# remains a separate, explicitly reviewed decision.
ecs_capacity_providers        = []
# Live cluster's containerInsights setting is confirmed disabled (aws ecs
# describe-clusters — Settings: [{name: containerInsights, value:
# disabled}]); this module previously hardcoded "enabled" unconditionally.
# Set to false for live-compatible adoption; enabling Container Insights on
# the live cluster later is a separate decision requiring its own cost and
# observability review, not a byproduct of import.
ecs_container_insights_enabled = false
ecr_repository_name           = "firmsbase-staging"
elasticache_subnet_group_name = "firmsbase-staging-cache-subnets"
# Live ElastiCache subnet group registers 6 subnets across every AZ in the
# VPC (confirmed via aws elasticache describe-cache-subnet-groups) — a
# genuinely broader set than the 2 subnets ECS places tasks into
# (private_subnet_ids). Previously this module conflated the two, silently
# under-representing live's real subnet-group membership. Order does not
# matter — the module compares membership as a set.
elasticache_subnet_ids = [
  "subnet-020540b8377bb4d0e",
  "subnet-0d328451d742a4a3c",
  "subnet-07efcb5d4bcf5aa59",
  "subnet-04f36560361246d4b",
  "subnet-0631d53a7acde6530",
  "subnet-06cb2ddbdb7cf4d69",
]
elasticache_engine            = "valkey"
elasticache_parameter_group_name = "default.valkey7"
# Live replication group's exact reported engine version is 7.2.6 (aws
# elasticache describe-cache-clusters .EngineVersion) — but AWS's
# aws_elasticache_replication_group requires major.minor-only format for
# Redis v6+/Valkey and rejects "7.2.6" outright; supply "7.2" here.
elasticache_engine_version        = "7.2"

# Live security group has a fixed, pre-existing name/description (aws ec2
# describe-security-groups) — name/description are both ForceNew on
# aws_security_group, so leaving these null against an already-imported
# live security group plans a disruptive replacement.
elasticache_security_group_name        = "firmsbase-staging-redis-sg"
elasticache_security_group_description = "Valkey access from FirmsBase staging ECS tasks"

# Same ForceNew rationale as elasticache_security_group_name/description
# above, for the ECS-tasks security group (referenced by both the RDS
# ingress rule and the Redis ingress rule — leaving this null forces a
# cascading replacement of both).
ecs_tasks_security_group_name        = "firmsbase-staging-ecs-sg"
ecs_tasks_security_group_description = "FirmsBase staging ECS tasks"

# Live subnet group/replication group descriptions (aws elasticache
# describe-cache-subnet-groups / describe-replication-groups) — both safely
# updatable in place, but left null they'd be silently overwritten on
# every plan (subnet group falls back to the generic "Managed by
# Terraform" placeholder).
elasticache_subnet_group_description      = "Subnets for FirmsBase staging Valkey"
elasticache_replication_group_description = "Valkey for FirmsBase staging sessions, cache, and queues"

# Live replication group already has automatic backups enabled at
# SnapshotRetentionLimit=1 (aws elasticache describe-replication-groups) —
# the module's own default of 0 (disabled) is safe only for a brand-new
# environment; leaving this at 0 here would propose disabling live backups.
elasticache_snapshot_retention_limit = 1
iam_task_execution_role_name  = "firmsbase-staging-ecs-execution-role"

# Live inline policy name (confirmed via aws iam get-role-policy) differs
# from what this module previously hardcoded
# ("${name_prefix}-task-execution") — aws_iam_role_policy's name is
# effectively immutable, so this must be set correctly before import, never
# used to rename the live policy. As of §9.18, this module's inline-policy
# CONTENT is also aligned to live's exact secrets-only shape — see
# docs/ecs/state-adoption-plan.md §9.18.
iam_task_execution_policy_name = "FirmsBaseStagingSecretsAccess"

# Live's sole attached managed policy (confirmed via aws iam
# list-attached-role-policies) — modeled as a separate, non-exclusive
# aws_iam_role_policy_attachment. See docs/ecs/state-adoption-plan.md §9.18.
iam_task_execution_managed_policy_arn = "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"

# Live inline policy's sole statement Sid (confirmed via aws iam
# get-role-policy) — a prior import mission wired this module's previous
# hardcoded "ReadTaskSecrets" instead, which never matched live. See
# docs/ecs/state-adoption-plan.md §9.19.
iam_task_execution_secrets_policy_sid = "ReadFirmsBaseStagingSecrets"

# Both live ECS roles (firmsbase-staging-ecs-execution-role AND
# firmsbase-staging-ecs-task-role) carry identical aws:SourceAccount /
# aws:SourceArn confused-deputy conditions on their assume-role trust
# policy (confirmed via aws iam get-role on both, 2026-08-05) — this one
# account ID is shared, not role-specific. See docs/ecs/state-adoption-plan.md §9.17.
aws_account_id = "603013471426"

# Live execution-role description (confirmed via aws iam get-role,
# 2026-08-05). No default — see variables.tf for why.
iam_task_execution_role_description = "Execution role for FirmsBase staging ECS tasks"

# ECS service desired counts — these four default to this module's
# original design intent (web/worker=2, critical_worker/scheduler=1). This
# staging environment's live services currently all run 1 (confirmed via
# aws ecs describe-services) — web and worker specifically diverge from
# their 2-task default. Set all four to 1 here so import doesn't leave a
# permanent drift that would silently scale live services up on the next
# apply. See docs/ecs/state-adoption-plan.md §9.10/§9.11.
web_desired_count             = 1
worker_desired_count          = 1
critical_worker_desired_count = 1
scheduler_desired_count       = 1

# ECS service deployment min/max healthy percent — all four default to this
# module's original design intent (100/200). This staging environment's
# live services all currently run 0/100 (confirmed via aws ecs
# describe-services, 2026-08-05). Set all eight here to match live exactly
# so import doesn't leave a permanent drift that would silently change
# live's rolling-deployment behavior on the next apply. These values
# preserve current live behavior for state adoption ONLY — they do not
# approve keeping 0/100 for a later production-style, no-downtime cutover,
# which is a separate, explicitly reviewed deployment decision. See
# docs/ecs/state-adoption-plan.md §9.20.
web_deployment_minimum_healthy_percent             = 0
web_deployment_maximum_percent                     = 100
worker_deployment_minimum_healthy_percent          = 0
worker_deployment_maximum_percent                  = 100
critical_worker_deployment_minimum_healthy_percent = 0
critical_worker_deployment_maximum_percent         = 100
scheduler_deployment_minimum_healthy_percent       = 0
scheduler_deployment_maximum_percent               = 100

# ECS service tags — web carries five live tags (confirmed via aws ecs
# describe-services --include TAGS, 2026-08-05); worker/critical-worker/
# scheduler carry none live, so their {} defaults already match and are
# left unset here. The ImageDigest value below is preserved exactly as it
# is live even though it is stale (does not match the currently running
# task definition's actual image digest) — correcting that is a separate,
# later, explicitly reviewed metadata change, not a byproduct of this
# adoption pass. See docs/ecs/state-adoption-plan.md §9.20.
web_tags = {
  SourceCommit = "6a1affdaad2bc1c4a48c5e411b9e39056039cde9"
  Environment  = "staging"
  ManagedBy    = "manual-reviewed-deployment"
  ImageDigest  = "sha256:92eecbeeef5225fcfe0f4256a0b375a773cd84c1f4974fc08b137811a27e46fd"
  Application  = "FirmsBase"
}

# ALB target-group health check — these three values match the currently
# running target group exactly (confirmed via aws elbv2
# describe-target-groups/describe-target-group-attributes) and must be used
# during state adoption so the import doesn't leave a permanent drift that
# would silently change live health-check behavior on the next apply. See
# docs/ecs/state-adoption-plan.md §9.5/§11. Any later migration to the
# module's original readiness-check design (path "/readyz", interval 15,
# matcher "200") must be a separate, deliberately reviewed deployment, not a
# byproduct of this import.
alb_health_check_path             = "/up"
alb_health_check_interval_seconds = 30
alb_health_check_matcher          = "200-399"

# Do NOT set private_egress_ready = true for this environment — it has no
# NAT gateway anywhere (see docs/ecs/state-adoption-plan.md §9.1). Left at
# its default (false) here deliberately, not omitted by accident.
# private_egress_ready = false
# nat_gateway_ids       = []
