# Copy to terraform.tfvars and fill in real values (or, better, pass
# sensitive values via -var/-var-file sourced from Secrets Manager at plan
# time rather than committing them to a tfvars file at all).
# terraform.tfvars is gitignored (see infrastructure/ecs/.gitignore) —
# never commit real values.
#
# Every value below is a placeholder. See docs/ecs/staging-readiness-report.md
# "required AWS inputs" for who needs to supply each one and why this
# mission does not fill them in itself.

aws_region  = "us-east-1"
name_prefix = "firmsbase-staging"

vpc_id              = "vpc-REPLACE_ME"
public_subnet_ids   = ["subnet-REPLACE_ME_PUBLIC_A", "subnet-REPLACE_ME_PUBLIC_B"]
private_subnet_ids  = ["subnet-REPLACE_ME_PRIVATE_A", "subnet-REPLACE_ME_PRIVATE_B"]
alb_ingress_cidr_blocks = ["203.0.113.0/24"] # replace with actual allowed staging-access range

acm_certificate_arn = "arn:aws:acm:us-east-1:ACCOUNT_ID:certificate/REPLACE_ME"

rds_instance_id       = "REPLACE_ME"
rds_security_group_id = "sg-REPLACE_ME"
db_host                = "REPLACE_ME.rds.amazonaws.com"
db_database              = "firmsbase_staging"

# Supplied by the CI/CD pipeline for a real deploy — see
# .github/workflows/ecs-pipeline.yml. Never hand-typed for anything beyond
# a local `terraform validate`/`plan` dry run.
app_image_digest = "ACCOUNT_ID.dkr.ecr.us-east-1.amazonaws.com/firmsbase-app@sha256:REPLACE_ME"

app_key_secret_arn          = "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:firmsbase/staging/app-key-REPLACE_ME"
db_password_secret_arn       = "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:firmsbase/staging/db-password-REPLACE_ME"
redis_auth_token_secret_arn   = "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:firmsbase/staging/redis-auth-token-REPLACE_ME"
# redis_auth_token: do NOT put the real value here — pass via
# `-var="redis_auth_token=$(aws secretsmanager get-secret-value ...)"` at
# plan/apply time instead.

alarm_sns_topic_arn = "arn:aws:sns:us-east-1:ACCOUNT_ID:REPLACE_ME"

enable_custom_metric_alarms = false

# --- SES bounce/complaint SQS consumer (ses-consumer role) — the queue
# URL/ARN and DLQ ARN below are resource IDENTIFIERS, not secrets, so this
# example shows the expected real staging naming/format directly (only the
# account ID is a placeholder, matching the rest of this file). The HMAC
# secret ARN below is likewise just an identifier — but the secret VALUE it
# points at must never appear here, in any tfvars file, in Terraform state,
# or in any Terraform output. See docs/ecs/iam-matrix.md and
# CorrelatedPasswordResetSenderService/PlatformNotificationCorrelationService.
ses_events_queue_url = "https://sqs.us-east-1.amazonaws.com/ACCOUNT_ID/firmsvault-staging-ses-events"
ses_events_queue_arn = "arn:aws:sqs:us-east-1:ACCOUNT_ID:firmsvault-staging-ses-events"
ses_events_dlq_arn   = "arn:aws:sqs:us-east-1:ACCOUNT_ID:firmsvault-staging-ses-events-dlq"

# --- SES outbound mail sending (web role only) — verified staging sender.
# Both values below are resource identifiers, not secrets: the identity ARN
# names a verified SES domain identity (no secret material), and the From
# address is the same one already configured as MAIL_FROM_ADDRESS in
# main.tf's shared_environment. Never grant this to ses_consumer or any
# other role — see infrastructure/ecs/modules/iam/main.tf and
# docs/ecs/iam-matrix.md.
ses_sending_identity_arn    = "arn:aws:ses:us-east-1:ACCOUNT_ID:identity/staging-mail.firmsvault.com"
ses_authorized_from_address = "no-reply@staging-mail.firmsvault.com"

# Generate this secret OUTSIDE Terraform (e.g. `aws secretsmanager
# create-secret` from a value produced by
# `php artisan tinker --execute="echo bin2hex(random_bytes(32));"`) and
# supply only its ARN here — never the value itself.
platform_notifications_recipient_fingerprint_hmac_key_secret_arn = "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:firmsbase/staging/platform-notifications-hmac-key-REPLACE_ME"

# Consumer tuning — safe defaults already match config/services.php's own
# env() fallbacks; only listed here for visibility/override.
ses_events_wait_time_seconds           = 20
ses_events_visibility_timeout_seconds  = 60
ses_events_max_messages                = 10
ses_consumer_desired_count             = 1
ses_consumer_cpu                       = 256
ses_consumer_memory                    = 512
ses_consumer_stop_timeout              = 45

# --- Live-infrastructure-adoption overrides — see
# docs/ecs/state-adoption-plan.md. All null/false by default (safe for a
# brand-new environment); THIS staging environment's live resources need
# every one of the non-comment values below set exactly as shown before any
# import is attempted — see the plan doc for why each one exists.
ecs_cluster_name              = "firmsbase-staging-cluster"
ecr_repository_name           = "firmsbase-staging"
elasticache_subnet_group_name = "firmsbase-staging-cache-subnets"
elasticache_engine            = "valkey"
elasticache_parameter_group_name = "default.valkey7"
# engine_version (already existed) must also be overridden to match the
# live Valkey 7.2 line — do not leave it at the module's "7.1" (Redis)
# default: engine_version = "7.2"
iam_task_execution_role_name  = "firmsbase-staging-ecs-execution-role"

# Do NOT set private_egress_ready = true for this environment — it has no
# NAT gateway anywhere (see docs/ecs/state-adoption-plan.md §9.1). Left at
# its default (false) here deliberately, not omitted by accident.
# private_egress_ready = false
# nat_gateway_ids       = []
