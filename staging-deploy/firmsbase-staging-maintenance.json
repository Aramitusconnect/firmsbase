{
  "family": "firmsbase-staging-maintenance",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::603013471426:role/firmsbase-staging-ecs-execution-role",
  "taskRoleArn": "arn:aws:iam::603013471426:role/firmsbase-staging-ecs-task-role",
  "containerDefinitions": [
    {
      "name": "app",
      "image": "603013471426.dkr.ecr.us-east-1.amazonaws.com/firmsbase-staging@sha256:92eecbeeef5225fcfe0f4256a0b375a773cd84c1f4974fc08b137811a27e46fd",
      "essential": true,
      "command": ["maintenance", "list"],
      "environment": [
        { "name": "APP_NAME", "value": "FirmsBase" },
        { "name": "APP_ENV", "value": "staging" },
        { "name": "APP_DEBUG", "value": "false" },
        { "name": "APP_MAINTENANCE_DRIVER", "value": "cache" },
        { "name": "APP_MAINTENANCE_STORE", "value": "redis" },
        { "name": "DB_CONNECTION", "value": "pgsql" },
        { "name": "DB_SSLMODE", "value": "require" },
        { "name": "REDIS_CLIENT", "value": "phpredis" },
        { "name": "REDIS_HOST", "value": "tls://master.firmsbase-staging-redis.ga5wre.use1.cache.amazonaws.com" },
        { "name": "REDIS_PORT", "value": "6379" },
        { "name": "REDIS_CACHE_DB", "value": "1" },
        { "name": "REDIS_QUEUE_DB", "value": "2" },
        { "name": "CACHE_STORE", "value": "redis" },
        { "name": "SESSION_DRIVER", "value": "redis" },
        { "name": "SESSION_SECURE_COOKIE", "value": "true" },
        { "name": "QUEUE_CONNECTION", "value": "redis" },
        { "name": "REDIS_QUEUE_CONNECTION", "value": "queue" },
        { "name": "REDIS_QUEUE_RETRY_AFTER", "value": "150" },
        { "name": "LOG_CHANNEL", "value": "stderr" },
        { "name": "LOG_LEVEL", "value": "info" },
        { "name": "MAIL_MAILER", "value": "log" }
      ],
      "secrets": [
        { "name": "APP_KEY", "valueFrom": "arn:aws:secretsmanager:us-east-1:603013471426:secret:firmsbase/staging/app-key-QigVGy:APP_KEY::" },
        { "name": "DB_HOST", "valueFrom": "arn:aws:secretsmanager:us-east-1:603013471426:secret:firmsbase/staging/database-app-8NUj2a:host::" },
        { "name": "DB_PORT", "valueFrom": "arn:aws:secretsmanager:us-east-1:603013471426:secret:firmsbase/staging/database-app-8NUj2a:port::" },
        { "name": "DB_DATABASE", "valueFrom": "arn:aws:secretsmanager:us-east-1:603013471426:secret:firmsbase/staging/database-app-8NUj2a:dbname::" },
        { "name": "DB_USERNAME", "valueFrom": "arn:aws:secretsmanager:us-east-1:603013471426:secret:firmsbase/staging/database-app-8NUj2a:username::" },
        { "name": "DB_PASSWORD", "valueFrom": "arn:aws:secretsmanager:us-east-1:603013471426:secret:firmsbase/staging/database-app-8NUj2a:password::" },
        { "name": "REDIS_PASSWORD", "valueFrom": "arn:aws:secretsmanager:us-east-1:603013471426:secret:firmsbase/staging/redis-auth-token-p6rVKN:REDIS_PASSWORD::" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/firmsbase-staging/app",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "maintenance"
        }
      }
    }
  ]
}
