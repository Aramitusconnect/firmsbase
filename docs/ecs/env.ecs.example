# Reference environment-variable set for ECS staging/production tasks.
#
# This is DOCUMENTATION, not a file the application reads. It is not named
# `.env.ecs` and is not gitignored-then-real — it lives under docs/ecs/ on
# purpose so nobody mistakes it for a real environment file to copy and fill
# in with secrets. Every *_SECRET/*_PASSWORD/*_KEY value below is a
# Secrets-Manager/SSM-Parameter-Store REFERENCE placeholder
# (arn:aws:secretsmanager:... / ssm:...), never a literal value — see
# docs/ecs/iam-matrix.md for how ECS task-definition `secrets` blocks resolve
# these at task start. Everything else is a plain, non-secret
# task-definition `environment` value.
#
# Values differ per role (web/worker/scheduler/migrate/maintenance) only
# where noted — most of this block is shared across every task definition
# for this application, since it is one image differing only by command
# (see docs/ecs/container-architecture.md).

# --- Application -------------------------------------------------------
APP_NAME=FirmsBase
APP_ENV=staging
APP_DEBUG=false
APP_URL=https://staging.example.invalid   # placeholder — real staging hostname is an AWS/DNS input, see staging-readiness-report.md
# Required canonical URL allow-list. Staging/production must set real
# environment-specific values. The web container derives
# FIRMSVAULT_ALB_HEALTHCHECK_HOST from MARKETING_URL at startup; operators
# should not manage that derived variable separately.
MARKETING_URL=https://staging.example.invalid
FIRM_APP_URL=https://app.staging.example.invalid
CLIENT_PORTAL_URL=https://client.staging.example.invalid
ADMIN_URL=https://admin.staging.example.invalid
MYATTORNEY_URL=https://myattorney.staging.example.invalid
API_URL=https://api.staging.example.invalid
APP_KEY={{secretsmanager:firmsbase/staging/app-key}}
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

# --- Database (RDS PostgreSQL) -----------------------------------------
DB_CONNECTION=pgsql
DB_HOST={{ssm:/firmsbase/staging/db/host}}
DB_PORT=5432
DB_DATABASE=firmsbase_staging
DB_USERNAME={{ssm:/firmsbase/staging/db/username}}
DB_PASSWORD={{secretsmanager:firmsbase/staging/db-password}}
DB_SSLMODE=require

# --- Redis (ElastiCache) -------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST={{ssm:/firmsbase/staging/redis/host}}
REDIS_PORT=6379
REDIS_PASSWORD={{secretsmanager:firmsbase/staging/redis-auth-token}}
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=redis
REDIS_QUEUE_CONNECTION=queue
REDIS_QUEUE_RETRY_AFTER=150   # see docs/ecs/queue-and-redis-architecture.md — must exceed worker --timeout

# --- Filesystem / S3 (prepared, not required until real document I/O exists
# — see docs/ecs/storage-readiness.md) -----------------------------------
FILESYSTEM_DISK=s3
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET={{ssm:/firmsbase/staging/s3/bucket-name}}
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY intentionally NOT set — the ECS
# task role supplies S3 credentials via the AWS SDK's default credential
# provider chain. See docs/ecs/iam-matrix.md.

# --- Logging (docs/ecs/observability.md) --------------------------------
LOG_CHANNEL=stderr
LOG_LEVEL=info

# --- Mail (deferred — no real mailer configured yet, see
# docs/ecs/ec2-dependency-audit.md §11; SES is the natural choice given the
# AWS target, included here as a placeholder for when it's wired up) -----
MAIL_MAILER=log

# --- Worker-role-only overrides (worker task definitions only) ----------
# WORKER_QUEUES=default,documents,notifications,integrations,billing,low-priority   # general worker
# WORKER_QUEUES=trust                                                              # critical worker
# WORKER_TRIES=3
# WORKER_TIMEOUT=90
# WORKER_MAX_JOBS=500
# WORKER_MAX_TIME=3600
# WORKER_MEMORY=256
# WORKER_BACKOFF=10,30,60
